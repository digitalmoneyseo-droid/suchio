{
  "name": "suchio-next",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun next build",
    "lint": "eslint .",
    "start": "bun --bun next start",
    "test": "bun test tests",
    "test:e2e": "playwright test",
    "typecheck": "next typegen && tsc --noEmit",
    "validate:content": "bun scripts/validate-content.mjs",
    "validate:seo": "bun scripts/validate-seo.mjs",
    "validate:performance": "bun scripts/validate-performance.mjs",
    "validate:bundle": "bun scripts/validate-client-bundle.mjs",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build && bun scripts/prepare-cloudflare-assets.mjs",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "bun scripts/deploy-verified.mjs",
    "deploy:redirects": "bun scripts/deploy-verified.mjs --redirects",
    "types:workers": "wrangler types src/worker-configuration.d.ts --env-interface CloudflareBindings --env-file .env.example"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@vinext/cloudflare": "^1.0.0-beta.6",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^0.468.0",
    "motion": "^12.43.0",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "server-only": "^0.0.1",
    "vinext": "^1.0.0-beta.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "^1.54.2",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "fontkit": "^2.0.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "wrangler": "^4.127.1"
  },
  "type": "module",
  "overrides": {
    "js-yaml": "4.3.2",
    "sharp": "0.35.4",
    "nanoid": "3.3.18"
  }
}
