{
  "name": "suchio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && bun scripts/prepare-cloudflare-assets.mjs",
    "start": "astro preview",
    "lint": "eslint .",
    "test": "bun test tests",
    "test:e2e": "playwright test",
    "typecheck": "astro check",
    "validate:content": "bun scripts/validate-content.mjs",
    "validate:seo": "bun scripts/validate-seo.mjs",
    "validate:performance": "bun scripts/validate-performance.mjs",
    "validate:bundle": "bun scripts/validate-client-bundle.mjs",
    "deploy": "bun scripts/deploy-verified.mjs",
    "deploy:redirects": "bun scripts/deploy-verified.mjs --redirects",
    "types:workers": "wrangler types src/worker-configuration.d.ts --env-interface CloudflareBindings --env-file .env.example"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/react": "^7.0.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "astro": "^7.3.5",
    "canvas-confetti": "^1.9.4",
    "lucide-react": "^0.468.0",
    "motion": "^12.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fontkit": "^2.0.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "wrangler": "^4.127.1"
  },
  "type": "module",
  "overrides": {
    "js-yaml": "4.3.2",
    "sharp": "0.35.4",
    "nanoid": "3.3.18",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@5": "5.0.12",
    "undici": "7.29.1"
  }
}
