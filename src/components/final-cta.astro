---
import CtaButton from "@/components/cta-button.astro";
import { localizePath, t, type Locale } from "@/lib/i18n";
interface Props { locale: Locale; singleLine?: boolean }
const { locale, singleLine = false } = Astro.props;
---
<section class="flex min-h-[28rem] flex-col items-center justify-center bg-black px-page py-section text-center text-inverse">
      <div class="reveal min-w-0 w-full" data-reveal>
        <h2 class={`mx-auto text-display-sm text-white ${singleLine ? "w-max max-w-full whitespace-nowrap max-nav:w-auto max-nav:whitespace-normal" : "max-w-[18ch]"}`}>{t(locale, "finalCta.title")}</h2>
        <p class="mx-auto mt-6 mb-7 max-w-[35rem] text-lg/7 text-inverse-muted">{t(locale, "finalCta.copy")}</p>
        <CtaButton href={localizePath("/contact", locale)} light>{t(locale, "home.ctaContact")}</CtaButton>
      </div>
    </section>
