---
import { ArrowLeft } from "lucide-react";
import type { NotFoundCopy } from "@/i18n/not-found";
interface Props { copy: NotFoundCopy; homeHref: string }
const { copy, homeHref } = Astro.props;
---
<main id="main-content" class="grid min-h-[70vh] place-items-center px-page py-section text-center"><div><p class="font-mono text-xs/4 font-medium tracking-widest uppercase text-muted">404</p><h1 class="mt-4 text-display-sm">{copy.title}</h1><p class="mx-auto mt-5 max-w-narrow text-lg/7 text-muted">{copy.copy}</p><a class="mt-8 inline-flex min-h-12 items-center gap-2 rounded-pill bg-inverse-surface px-5 text-ui font-semibold text-white shadow-dark-surface transition-[background-color,scale,box-shadow] duration-150 hover:bg-inverse-surface-hover hover:shadow-dark-surface-hover active:scale-[.96] motion-reduce:transition-none motion-reduce:active:scale-100" href={homeHref}><ArrowLeft className="size-4" aria-hidden="true" />{copy.back}</a></div></main>
