---
import EditorialHero from "@/components/editorial-hero.astro";
import FinalCta from "@/components/final-cta.astro";
import Reveal from "@/components/reveal.astro";
import SectionHeading from "@/components/section-heading.astro";
import { t, type Locale } from "@/lib/i18n";
interface Props { locale: Locale }
const { locale } = Astro.props;
const principles = [
    ["about.principle1Title", "about.principle1Copy"],
    ["about.principle2Title", "about.principle2Copy"],
    ["about.principle3Title", "about.principle3Copy"],
    ["about.principle4Title", "about.principle4Copy"],
  ] as const;
---
<main id="main-content">
      <EditorialHero
        title={t(locale, "about.title")}
        copy={t(locale, "about.copy")}
      />

      <section class="bg-canvas px-page py-section">
        <div class="mx-auto grid max-w-[70rem] grid-cols-[minmax(15rem,.78fr)_minmax(0,1.22fr)] gap-x-split gap-y-8 max-compact:grid-cols-1">
          <Reveal>
            <h2 class="m-0 max-w-[12ch] text-heading-lg">{t(locale, "about.pov")}</h2>
          </Reveal>
          <Reveal className="grid max-w-[45rem] gap-6" delay={60}>
            <p class="m-0 text-lg/7 text-ink">
              {t(locale, "about.pov1")}
            </p>
            <p class="m-0 text-lg/7 text-muted">
              {t(locale, "about.pov2")}
            </p>
          </Reveal>
        </div>
      </section>

      <section class="px-page py-section">
        <div class="mx-auto max-w-[70rem]">
          <SectionHeading
            title={t(locale, "about.howTitle")}
            copy={t(locale, "about.howCopy")}
          />
          <div class="grid grid-cols-2 gap-x-grid max-compact:grid-cols-1">
            {principles.map(([headingKey, copyKey], index) => (
              <Reveal className="py-8" delay={index * 50} >
                <h3 class="m-0 max-w-[22ch] text-heading-sm">{t(locale, headingKey)}</h3>
                <p class="mt-3 mb-0 max-w-[38rem] text-base/6 text-muted">{t(locale, copyKey)}</p>
              </Reveal>
            ))}
          </div>
        </div>
      </section>

      <FinalCta locale={locale} />
    </main>
