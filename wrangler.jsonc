{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "suchio",
  "account_id": "82dacf4c35b3f8082eb4b1090a08ea0c",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "src/cloudflare-worker.ts",
  "workers_dev": false,
  "vars": {
    "AUDIT_ADMIN_EMAIL": "contact@suchio.net"
  },
  "d1_databases": [
    {
      "binding": "AUDIT_DB",
      "database_name": "suchio-audit-visits",
      "database_id": "2c9456c0-4b91-422a-985c-93fada65e7ad",
      "migrations_dir": "migrations/audit-visits"
    }
  ],
  "triggers": {
    "crons": [
      "17 * * * *"
    ]
  },
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "2026090501",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "routes": [
    {
      "pattern": "suchio.net",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "dist/client",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/de",
      "/de/*",
      "/api/*",
      "/admin/audits",
      "/admin/audits/*",
      "/services/websites-apps",
      "/services/seo-ai-visibility",
      "/services/paid-campaigns",
      "/services/ai-automation",
      "/en/services/websites-apps",
      "/en/services/seo-ai-visibility",
      "/en/services/paid-campaigns",
      "/en/services/ai-automation",
      "/fr/services/websites-apps",
      "/fr/services/seo-ai-visibility",
      "/fr/services/paid-campaigns",
      "/fr/services/ai-automation"
    ]
  },
  "cache": {
    "enabled": true
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 0.1
    }
  }
}
