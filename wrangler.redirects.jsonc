{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "suchio-domain-redirect",
  "account_id": "82dacf4c35b3f8082eb4b1090a08ea0c",
  "compatibility_date": "2026-08-26",
  "main": "src/domain-redirect-worker.ts",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "http://suchio.net/*",
      "zone_name": "suchio.net"
    },
    {
      "pattern": "www.suchio.net/*",
      "zone_name": "suchio.net"
    }
  ]
}
